{
  "name": "tdf-language-support",
  "displayName": "TDF & TBF Language Support",
  "description": "Syntax highlighting and language support for TDF and TBF files.",
  "version": "1.0.0",
  "publisher": "spideythedev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Oobli/tdf-tdb.git",
    "directory": "packages/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "icon": "images/extension-icon.png",
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "syntaxes/**",
    "icons/**",
    "images/**",
    "language-configuration.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tdf",
        "aliases": [
          "TDF",
          "Typed Data Format"
        ],
        "extensions": [
          ".tdf"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "tbf",
        "aliases": [
          "TBF",
          "Typed Binary Format"
        ],
        "extensions": [
          ".tbf"
        ]
      }
    ],
    "grammars": [
      {
        "language": "tdf",
        "scopeName": "source.tdf",
        "path": "./syntaxes/tdf.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "tdf.inspectTBF",
        "title": "TDF: Inspect TBF Header"
      }
    ],
    "iconThemes": [
      {
        "id": "tdf-file-icons",
        "label": "TDF & TBF File Icons",
        "path": "./icons/file-icons.json"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p .",
    "vscode:prepublish": "pnpm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
